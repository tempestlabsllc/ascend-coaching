
# Stripe secret key (test mode first: sk_test_...). Without it, checkout runs in demo mode.
STRIPE_SECRET_KEY=
# Set to true after enabling Stripe Tax in the dashboard to charge sales tax at checkout.
STRIPE_AUTOMATIC_TAX=false
# Customer Portal login link so clients can cancel/switch plans (https://billing.stripe.com/p/login/...)
NEXT_PUBLIC_STRIPE_PORTAL_URL=

# Booking link (Cal.com or Calendly). Shown embedded on /book.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/supportascendcoaching/30min

# Intake questionnaires are emailed to the site email (src/config/site.ts) on the live site.
# Override the address here, or send them to a webhook (Zapier/Make/Google Sheets) instead.
INTAKE_EMAIL=
INTAKE_WEBHOOK_URL=

# Private admin dashboard at /admin (revenue + discount codes). At least 12 characters.
# Changing it logs out every device. Never commit the real value.
ADMIN_PASSWORD=
